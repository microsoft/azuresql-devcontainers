<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.Build.Sql/2.2.0">
  <PropertyGroup>
    <Name>Library</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <!-- Case-insensitive model, like SQL Server's default collation. Without it the build treats names as case-sensitive. -->
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <PostDeploy Include="postDeployment.sql" />
  </ItemGroup>
</Project>
